# Ignore the "build" directory created by esp-idf
build

# Ignore the user-customized project configuration file.
# (https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/kconfig.html)
sdkconfig*
# Unignore the default project configuration file.
!sdkconfig.defaults

# Ignore IDE configs
.vscode

dependencies.lock

# PlatformIO build artifacts
firmware/.pio

# Local symlinks created to point PlatformIO's LDF at one clockface at a time.
# CI builds use the same trick (see clockwise-ci.yml) but clean up after.
firmware/lib/cw-cf-*